{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Api": {
    "Name": "Contracts Billing API",
    "Version": "v1",
    "Environment": "Development"
  },

  "Database": {
    "Provider": "SqlServer",
    "ConnectionString": "Server=localhost\\SQLEXPRESS;Database=NurtricenterContracts;Trusted_Connection=True;TrustServerCertificate=True;",
    "EnableSensitiveDataLogging": true,
    "EnableDetailedErrors": true
  },

  "Jwt": {
    "Issuer": "Nurtricenter",
    "Audience": "NurtricenterClients",
    "SecretKey": "XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX",
    "ExpirationMinutes": 60
  },

  "Catering": {
    "BaseUrl": "https://localhost:7001",
    "ServicesEndpoint": "/api/services",
    "TimeoutSeconds": 30
  },

  "Nutrition": {
    "BaseUrl": "https://localhost:7002",
    "ServicesEndpoint": "/api/services",
    "TimeoutSeconds": 30
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://localhost:4200"
    ]
  },

  "Swagger": {
    "Enabled": true,
    "Title": "Nurtricenter Contracts Billing API",
    "Version": "v1"
  },
  "JsonCateringDataPath": "ExternalServices/Catering",
  "JsonNutritionDataPath": "ExternalServices/Nutrition"
}